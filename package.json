{
  "name": "deepseek-desk",
  "version": "0.4.0",
  "private": true,
  "description": "Local DeepSeek chat, web research and workspace assistant",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:win": "npm run build:editor && node scripts/prepare-source.cjs && electron-builder --win nsis --x64 --publish never",
    "build:mac": "npm run build:editor && node scripts/prepare-source.cjs && electron-builder --mac dmg --publish never",
    "build:editor": "node scripts/build-editor.cjs",
    "prestart": "npm run build:editor"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "productName": "DeepSeek Desk",
  "author": "Meigao",
  "license": "UNLICENSED",
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "cheerio": "1.1.2",
    "codemirror": "6.0.2",
    "electron-updater": "6.8.9",
    "pdf-parse": "2.4.5"
  },
  "build": {
    "appId": "school.meigao.deepseekdesk",
    "productName": "DeepSeek Desk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "DeepSeek-Desk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "build-source",
        "to": "editable-source"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://github.com/WINSTON672/deepseek-desk/releases/latest/download"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "DeepSeek-Desk-${version}-mac-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/@napi-rs/**/*",
      "node_modules/pdf-parse/**/*",
      "node_modules/pdfjs-dist/**/*"
    ]
  }
}
