{
  "name": "deepseek-desk",
  "version": "0.3.3",
  "private": true,
  "description": "Local DeepSeek chat, web research and workspace assistant",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:win": "node scripts/prepare-source.cjs && electron-builder --win nsis --x64 --publish never",
    "build:mac": "node scripts/prepare-source.cjs && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "productName": "DeepSeek Desk",
  "author": "Meigao",
  "license": "UNLICENSED",
  "dependencies": {
    "cheerio": "1.1.2",
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "school.meigao.deepseekdesk",
    "productName": "DeepSeek Desk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "DeepSeek-Desk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "build-source",
        "to": "editable-source"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://github.com/WINSTON672/deepseek-desk/releases/latest/download"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "DeepSeek-Desk-${version}-mac-${arch}.${ext}"
    }
  }
}
